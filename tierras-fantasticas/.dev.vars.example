# Claves para probar la web en local con `npm run dev`. En Cloudflare se ponen como Secrets
# (Workers & Pages → tierras-fantasticas → Settings → Variables and Secrets).

# Clave compartida con el puente del servidor (bridge.secret en config/tfclient-server.properties)
BRIDGE_SECRET=

# Dirección pública de la web (opcional: si falta se usa la de cada petición)
# PUBLIC_URL=https://xn--tierrasfantsticas-hpb.store

# --- Stripe (https://dashboard.stripe.com → Developers). En Cloudflare van como Secrets, nunca en el repositorio ---
# Secret key (sk_test_... en pruebas, sk_live_... en real)
STRIPE_SECRET_KEY=
# Signing secret del webhook https://TU-DOMINIO/webhook/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
