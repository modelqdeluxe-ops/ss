# Copia este archivo como .env y rellena los valores.

# --- Web ---
PORT=3000
# Dirección pública de la web (necesaria para volver desde Discord)
PUBLIC_URL=http://localhost:3000
# Texto largo y aleatorio para firmar las sesiones (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=
SERVER_NAME=Tierras Fantásticas
SERVER_IP=play.tierrasfantasticas.net
DISCORD_URL=https://discord.gg/tRrunHBZE

# --- PayPal (https://developer.paypal.com/dashboard/applications) ---
# "sandbox" para pruebas, "live" para cobrar de verdad
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=tu-client-id
PAYPAL_CLIENT_SECRET=tu-secret
# ID del webhook que creas en la misma app de PayPal (opcional pero recomendado)
PAYPAL_WEBHOOK_ID=
# Moneda admitida por PayPal: USD, EUR, MXN, BRL, GBP, CAD... (COP, CLP, PEN y ARS no están soportadas)
CURRENCY=USD

# --- RCON del servidor de Minecraft (server.properties: enable-rcon=true) ---
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=cambia-esta-contraseña

# --- Discord (https://discord.com/developers/applications) ---
# OAuth2 de tu aplicación: para que el comprador vincule su cuenta
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot de la misma aplicación (pestaña Bot → Reset Token) para dar los roles
DISCORD_BOT_TOKEN=
# ID de tu servidor de Discord (clic derecho en el servidor → Copiar ID)
DISCORD_GUILD_ID=
# Webhook del canal donde se anuncian las compras (Editar canal → Integraciones → Webhooks)
DISCORD_WEBHOOK_URL=
