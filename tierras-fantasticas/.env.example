# Copia este archivo como .env y rellena los valores.

# --- Web ---
PORT=3000
SERVER_NAME=Tierras Fantásticas
SERVER_IP=play.tierrasfantasticas.net
DISCORD_URL=https://discord.gg/tu-invitacion

# --- PayPal (https://developer.paypal.com/dashboard/applications) ---
# "sandbox" para pruebas, "live" para cobrar de verdad
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=tu-client-id
PAYPAL_CLIENT_SECRET=tu-secret
# ID del webhook que creas en la misma app de PayPal (opcional pero recomendado)
PAYPAL_WEBHOOK_ID=
# Moneda admitida por PayPal: USD, EUR, MXN, BRL, GBP, CAD... (COP, CLP, PEN y ARS no están soportadas)
CURRENCY=USD

# --- RCON del servidor de Minecraft (server.properties: enable-rcon=true) ---
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=cambia-esta-contraseña
