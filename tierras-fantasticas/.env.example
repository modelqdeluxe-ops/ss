# Copia este archivo como .env y rellena los valores.

# --- Web ---
PORT=3000
# URL pública donde está la web (se usa para volver desde Stripe)
PUBLIC_URL=http://localhost:3000
SERVER_NAME=Tierras Fantásticas
SERVER_IP=play.tierrasfantasticas.net
DISCORD_URL=https://discord.gg/tu-invitacion

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Usa sk_test_... para pruebas y sk_live_... en producción
STRIPE_SECRET_KEY=sk_test_xxx
# Firma del webhook (https://dashboard.stripe.com/webhooks o `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Moneda ISO en minúsculas: usd, eur, mxn, cop, clp, pen, ars...
CURRENCY=usd

# --- RCON del servidor de Minecraft (server.properties: enable-rcon=true) ---
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=cambia-esta-contraseña
