<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/rumi_widget_bg"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rumentis"
            android:textColor="#FFF0BF33"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/w_anotar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rumi_widget_pill"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="+ Anotar"
            android:textColor="#FF1A2B3A"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <TextView
        android:id="@+id/w_grande"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Abre Rumentis"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFB9C6D3"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/w_tareas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFF1EDE5"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/w_rumi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/rumi_widget_caja"
        android:padding="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/w_act"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF8FA1B3"
        android:textSize="10sp"
        android:maxLines="1"/>
</LinearLayout>
